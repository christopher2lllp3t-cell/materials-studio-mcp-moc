{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "materials-studio-mcp/scientific-gate-intake/v1",
  "title": "Target-model scientific gate intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "model_role", "source_evidence", "structure_file", "cell", "surface", "charge_compensation", "fixed_regions", "fluid", "forcefield", "atom_types_and_charges", "electrostatics", "lammps_units", "replicas", "trajectory_plan"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "model_role": {"const": "target"},
    "source_evidence": {"$ref": "#/$defs/source_evidence"},
    "structure_file": {"$ref": "#/$defs/hashed_path"},
    "expected_elements": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["matrix_angstrom", "periodic_boundary"], "properties": {"matrix_angstrom": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}, "periodic_boundary": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["p", "f", "s", "m"]}}}},
    "surface": {"type": "object", "additionalProperties": false, "required": ["miller_index", "termination", "hydroxylation_rule"], "properties": {"miller_index": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer"}}, "termination": {"type": "string", "minLength": 1}, "hydroxylation_rule": {"type": "string", "minLength": 1}}},
    "charge_compensation": {"type": "string", "minLength": 1},
    "fixed_regions": {"type": "object", "minProperties": 1},
    "fluid": {"type": "object", "additionalProperties": false, "required": ["composition", "density_g_cm3", "temperature_k", "pressure_mpa"], "properties": {"composition": {"type": "array"}, "density_g_cm3": {"type": ["number", "null"]}, "temperature_k": {"type": ["number", "null"]}, "pressure_mpa": {"type": ["number", "null"]}, "not_applicable": {"type": "boolean"}}},
    "forcefield": {"type": "object", "additionalProperties": false, "required": ["name", "version", "parameter_sources"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "parameter_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashed_path"}}}},
    "atom_types_and_charges": {"type": "object", "additionalProperties": false, "required": ["atom_type_source", "partial_charge_source"], "properties": {"atom_type_source": {"type": "string", "minLength": 1}, "partial_charge_source": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "electrostatics": {"type": "object", "additionalProperties": false, "required": ["long_range", "mixing_rule", "special_bonds"], "properties": {"long_range": {"type": "string", "minLength": 1}, "mixing_rule": {"type": "string", "minLength": 1}, "special_bonds": {"type": "string", "minLength": 1}}},
    "lammps_units": {"type": "string", "minLength": 1},
    "replicas": {"type": "object", "additionalProperties": false, "required": ["seeds", "repeat_count"], "properties": {"seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}}, "repeat_count": {"type": "integer", "minimum": 1}}},
    "trajectory_plan": {"type": "object", "additionalProperties": false, "required": ["equilibration_steps", "production_steps"], "properties": {"equilibration_steps": {"type": "integer", "minimum": 1}, "production_steps": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {
    "hashed_path": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}},
    "source_evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "citation_or_id"], "properties": {"kind": {"enum": ["literature", "raw_structure", "literature_and_raw_structure"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "citation_or_id": {"type": "string", "minLength": 1}}}
  }
}
